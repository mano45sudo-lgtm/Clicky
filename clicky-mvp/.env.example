# OPTIONAL. The app has a full Settings window; values here just seed defaults
# on first run and are stored to clicky-settings.json afterwards.
# Leave everything blank to run in mock mode (no keys, no network).

# --- Brain (pick one) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
SARVAM_API_KEY=
CLICKY_PROVIDER=            # gemini | anthropic | sarvam | mock
GEMINI_MODEL=               # default: gemini-2.5-flash
ANTHROPIC_MODEL=            # default: claude-3-5-sonnet-latest
SARVAM_MODEL=               # default: sarvam-105b

# --- Speech (optional cloud; OS-native works with no key on Windows) ---
STT_PROVIDER=               # os | assemblyai | sarvam | mock
TTS_PROVIDER=               # os | elevenlabs | sarvam | mock
ASSEMBLYAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Sarvam speech uses SARVAM_API_KEY above. Set these to 1 to route speech:
SARVAM_STT=                 # 1 => Sarvam Saaras for speech-to-text
SARVAM_TTS=                 # 1 => Sarvam Bulbul for text-to-speech
SARVAM_SPEAKER=             # bulbul voice, e.g. shubh | aditya | ritu | priya
SARVAM_STT_MODEL=           # default: saaras:v4
SARVAM_TTS_MODEL=           # default: bulbul:v3
CLICKY_VOICE=               # named OS voice (blank = system default)

# --- Web search for the agent (optional) ---
WEB_SEARCH_PROVIDER=        # none | serper | brave
SERPER_API_KEY=
BRAVE_API_KEY=

# --- Misc ---
CLICKY_HOTKEY=              # uiohook keycode; default 29 (Left Ctrl)
CLICKY_MOCK=                # 1 forces mock mode
