{
  "name": "heyclicky",
  "version": "0.1.0",
  "description": "HeyClicky: a voice-first Windows desktop buddy. Hold a key and speak - it sees your screen, plans with a Groq brain, and acts via UI Automation, typing, and Chrome DevTools Protocol, with stop key and confirm-before-destructive guardrails.",
  "author": "HeyClicky",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win",
    "test:smoke": "node scripts/smoke.js",
    "get:whisper": "node scripts/get-whisper-model.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@google/generative-ai": "^0.21.0",
    "dotenv": "^16.4.5",
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.heyclicky.app",
    "productName": "HeyClicky",
    "files": [
      "main.js",
      "preload.js",
      "config.js",
      "store.js",
      "index.html",
      "renderer.js",
      "command.html",
      "command.js",
      "settings.html",
      "settings.js",
      "onboard.html",
      "onboard.js",
      "services/**/*",
      "assets/**/*",
      "README.md",
      "package.json"
    ],
    "publish": {
      "provider": "github",
      "owner": "heyclicky",
      "repo": "heyclicky"
    },
    "asarUnpack": [
      "**/node_modules/uiohook-napi/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "category": "Utility",
      "target": ["AppImage", "deb"]
    }
  }
}
